# LOCAL TEMPLATE ONLY: never commit .env, credentials, customers, invoices or DB dumps.
# Configure secrets privately on the separate Facturations app, never on TAKATAK production.
NODE_ENV=development
PORT=3000

# Required as FACTURATIONS_TRUST_PROXY=1 in NODE_ENV=production.
# This is an application assertion only: the hosting/network layer MUST also make
# the Node port unreachable directly and allow traffic only from the trusted HTTPS proxy.
FACTURATIONS_TRUST_PROXY=

# Temporary, PRIVATE server-to-server/testing access only; NEVER place in a browser.
TAKATAK_ADMIN_KEY=
# Optional Wave read-only business listing; NOT OAuth or invoice creation.
WAVE_ACCESS_TOKEN=

# BOTH required together to enable dedicated draft storage.
# New isolated PostgreSQL DB only; apply reviewed migrations 001–026 in numeric order there.
# Never point this application at an existing GROUPE TAKATAK database.
FACTURATIONS_DATABASE_URL=
WAVE_BUSINESS_ID=

# BOTH required together, along with the dedicated DB, for opt-in browser staff login
# AND private cookie-authenticated draft workspace routes. These routes are NOT
# automatically disabled by NODE_ENV=production; do not enable before security sign-off.
# Leave blank until isolated HTTPS staging, trusted reverse proxy, verified enrollment,
# MFA recovery, independent security review and rate limits are ready.
# In NODE_ENV=production the dedicated DB, business ID, HTTPS origin, MFA key and
# FACTURATIONS_TRUST_PROXY=1 are all mandatory; startup fails closed otherwise.
# External origin must be exact HTTPS origin, without slash or path.
FACTURATIONS_PUBLIC_ORIGIN=
# Separately generated random 32-byte (64 hex character) encryption key; server-only.
# Loss of this key makes enrolled TOTP secrets unrecoverable: plan rotation/recovery.
FACTURATIONS_TOTP_ENCRYPTION_KEY=
