# LOCAL/STAGING TEMPLATE ONLY: never commit .env, credentials, customers, invoices or DB dumps.
# Configure secrets privately on the separate Facturations application, never on TAKATAK production.
#
# Production is fail-closed:
# - NODE_ENV=production
# - non-zero PORT
# - FACTURATIONS_DATABASE_URL + WAVE_BUSINESS_ID
# - exact HTTPS FACTURATIONS_PUBLIC_ORIGIN
# - 32-byte FACTURATIONS_TOTP_ENCRYPTION_KEY
# - FACTURATIONS_TRUST_PROXY=1
# must all be present before the process starts.
NODE_ENV=development
PORT=3000

# Mandatory as FACTURATIONS_TRUST_PROXY=1 in NODE_ENV=production.
# The Node port must also be unreachable directly from the Internet; only the trusted
# HTTPS reverse proxy may connect to it. The header check is not a firewall.
FACTURATIONS_TRUST_PROXY=

# Temporary PRIVATE server-to-server/testing access only; NEVER place in a browser.
# May remain blank when those legacy/private API routes are intentionally disabled.
TAKATAK_ADMIN_KEY=

# Optional Wave read-only business listing only. This is NOT authorization for invoice writes.
WAVE_ACCESS_TOKEN=

# Dedicated Facturations PostgreSQL database ONLY.
# Before staging/production, have migrations 001-027 reviewed, integrity-locked and applied in numeric order
# to this isolated database, with least-privilege SQL credentials and backup/restore proof.
FACTURATIONS_DATABASE_URL=
WAVE_BUSINESS_ID=

# Required together to enable staff login and the client portal.
# Production rejects an incomplete pair and rejects loopback origins.
# Use the exact public HTTPS origin, with no trailing slash, path, query or credentials.
FACTURATIONS_PUBLIC_ORIGIN=

# Separately generated random 32-byte (64 hex character) server-only encryption key.
# Never reuse another TAKATAK application's key. Loss of this key affects enrolled TOTP
# recovery, so keep an approved private recovery/rotation procedure.
FACTURATIONS_TOTP_ENCRYPTION_KEY=


# Optional TAKATAK Dashboard server-to-server integration.
# Leave disabled until isolated HTTPS staging exists and the issuer/audience/business
# mapping has been reviewed. These values are SERVER ONLY and never belong in browser code.
FACTURATIONS_INTEGRATION_ENABLED=
FACTURATIONS_INTEGRATION_ISSUER=
FACTURATIONS_INTEGRATION_AUDIENCE=
# Dedicated shared secret for the current HS256 v1 integration, minimum 32 characters.
# Generate independently; never reuse TAKATAK_ADMIN_KEY, database, TOTP or provider secrets.
FACTURATIONS_INTEGRATION_HMAC_SECRET=
